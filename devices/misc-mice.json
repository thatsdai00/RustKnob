    {"protocol": "w1", "feat": 9, "vars": {"cable": 0}, "replies": ["09 8F 00 12 00 00 00 00 00", "09 86 00 00 00 00 00 00 00", "09 86 00 00 00 00 00 00 00", "09 86 00 00 00 00 00 00 00", "09 86 00 00 00 00 00 00 00", "09 86 00 00 00 00 00 00 00", "09 D5 01"], "sent": ["09 8F"], "expect": [{"percent": 85, "charging": true}]},
    {"protocol": "w1", "feat": 9, "vars": {"cable": 0}, "replies": ["09 8F 00 02 00 00 00 00 00", "09 89 3C 00 00 00 00 00 00"], "expect": [{"percent": 60}]}
