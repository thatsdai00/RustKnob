{
  "v": 1,
  "devices": [
    ["248A:FA02", "mw", "Niceboy MW400", "mouse"]
  ],
  "protocols": {
    "mw": {"pick": [{"mi": 0, "page": "0001", "usage": "0000", "in": 33, "out": 33}], "open": "rw", "grace": 1800,
      "run": [
        {"flush": 1},
        {"out": "05 24 FA 48"},
        {
          "read": 500,
          "if": {"all": [{"len": 7}, {"eq": [{"b": 0}, 5]}, {"eq": [{"b": 2}, 250]}, {"eq": [{"b": 3}, 72]}]}
        },
        {"first": [
            [
              {"need": {"all": [{"eq": [{"b": 4}, 0]}, {"eq": [{"b": 5}, 0]}, {"eq": [{"b": 6}, 0]}]}},
              {"emit": {"state": "asleep"}},
              {"stop": 1}
            ],
            []
          ]},
        {"set": {"mv": {"div": [{"mul": [{"u16le": 4}, 990]}, 240]}}},
        {"emit": {
            "percent": {"if": [
                {"ge": ["$mv", 4200]},
                100,
                {"if": [
                    {"ge": ["$mv", 4100]},
                    90,
                    {"if": [
                        {"ge": ["$mv", 4000]},
                        80,
                        {"if": [
                            {"ge": ["$mv", 3900]},
                            70,
                            {"if": [
                                {"ge": ["$mv", 3800]},
                                60,
                                {"if": [
                                    {"ge": ["$mv", 3700]},
                                    50,
                                    {"if": [
                                        {"ge": ["$mv", 3500]},
                                        40,
                                        {"if": [{"ge": ["$mv", 3400]}, 30, {"if": [{"ge": ["$mv", 3200]}, 20, 10]}]}
                                      ]}
                                  ]}
                              ]}
                          ]}
                      ]}
                  ]}
              ]},
            "charging": {"ne": [{"b": 6}, 0]}
          }}
      ]}
  },
  "tests": [
    {"protocol": "mw", "out": 33, "replies": ["05 49 FA 48 EA 03 00"], "sent": ["05 24 FA 48"], "expect": [{"percent": 90}]},
    {"protocol": "mw", "out": 33, "replies": ["05 49 FA 48 00 00 00"], "expect": [{"state": "asleep"}]}
  ]
}
