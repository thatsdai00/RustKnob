              {"emit": {
                  "id": {"add": ["$u", 0]},
                  "percent": "$val",
                  "charging": {"ne": [{"b": {"sub": [10, "$d"]}}, 0]},
                  "asleep": {"not": {"all": [{"ge": ["$val", 1]}, {"le": ["$val", 100]}]}}
                }}
            ]
          ]}
      ]},
    "omni": {"pick": [{"mi": 2, "out": [12]}], "open": "rw",
      "run": [
